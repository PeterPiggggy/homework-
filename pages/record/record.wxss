.hole-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  font-size: 50rpx;
}



.welcome-tips {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  width: 650rpx;
  height: 200rpx;
  background-color: #696969;

  margin: 50rpx 0 100rpx 0;
  border: 5rpx solid #000000;
  border-radius: 20rpx;

  color: #ffffff;
}



.history-list {
  overflow-y: auto;
  
  width: 650rpx;
  height: 900rpx;
  background-color: #b3acac;

  border: 5rpx solid #000000;
  border-radius: 20rpx;
}