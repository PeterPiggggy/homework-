.hole_page {
  display: flex;
  flex-wrap: wrap;
  flex-direction: column;
  
}


.title {
  width: 750rpx;
  height: 200rpx;
  background-color: #696969;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 50rpx;
}


.mask {
  position: fixed;
  background-color: #69696980;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
}


.make_choices {
  background-color: #ffffff;
  position: absolute;
}


.buttons {
  display: flex;
  flex-direction: row;
}