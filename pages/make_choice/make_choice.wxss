.hole-page {
  display: flex;
  flex-direction: column;
  align-items: center;

  font-size: 50rpx;
}



.welcome-tips {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  width: 650rpx;
  height: 200rpx;
  background-color: #696969;

  margin: 50rpx 0 100rpx 0;
  border: 5rpx solid #000000;
  border-radius: 20rpx;
  
  color: #ffffff;
}



.option-list {
  overflow-y: auto;

  width: 650rpx;
  height: 740rpx;
  background-color: #b3acac;

  margin-bottom: 100rpx;
  border: 5rpx solid #000000;
  border-radius: 20rpx;
}
.option-list .option {
  display: flex;
  flex-direction: row;

  position: relative;

  width: 600rpx;
  min-height: 150rpx;
  background-color: #ffffff;
  
  margin: 10rpx 25rpx 0rpx 25rpx;
  border-radius: 20rpx;
}
.option .option-icon {
  display: flex;
  justify-content: center;
  align-items: center;

  width: 150rpx;
  min-height: 150rpx;
}
.option .option-text {
  width: 450rpx;
  min-height: 150rpx;

  border-left: 5rpx solid #000000;

  color: #000000;
  word-break: break-all;
}
.option-list .option .delete-menu {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 999;

  border: 5rpx solid #ffffff;
  border-radius: 0 20rpx 0 0;

  width: 100rpx;
  height: 70rpx;
  background-color: #ff0000;

  color: #ffffff;
}
.option-list .option-list-tips {
  display: flex;
  flex-direction: column;
  align-items: center;

  margin-top: 300rpx;

  color: #000000;
}



.main-buttons {
  display: flex;
  flex-direction: row;
}



.make-options {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.make-options .make-options-tips {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  width: 700rpx;
  height: 250rpx;
  background-color: #696969;

  margin-bottom: 50rpx;
  border: 5rpx solid #000000;
  border-radius: 20rpx;

  color: #ffffff;
}
.make-options .input-options {
  width: 600rpx;
  height: 100rpx;
  background-color: #ffffff;

  border-radius: 20rpx;
  border: 5rpx solid #000000;
  margin-bottom: 50rpx;

  color: #000000;
}
.make-options .choose-icons {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;

  width: 600rpx;
  height: 600rpx;
}
.make-options .choose-icons .option-icon {
  position: relative;

  width: 160rpx;
  height: 160rpx;
  background-color: #ffffff;

  border: 5px solid #000000;
  border-radius: 20rpx;
}
.make-options .choose-icons .option-icon .icon-mask {
  position: absolute;
  top: 0;
  left: 0;

  width: 100%;
  height: 100%;
  background-color: #69696980;
}
.make-options .make-options-buttons {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: space-between;
  
  width: 750rpx;

  margin-top: 100rpx;
}



.result {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.result .result-tips {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  width: 650rpx;
  height: 200rpx;
  background-color: #696969;

  margin: 50rpx 0 100rpx 0;
  border: 5rpx solid #000000;
  border-radius: 20rpx;

  color: #ffffff;
}
.result .option-chosen {
  display: flex;
  flex-direction: row;

  width: 650rpx;
  min-height: 200rpx;
  background-color: #ffffff;

  border: 5rpx solid #000000;
  border-radius: 20rpx;

  color: #000000;
}
.result .option-chosen .icon-chosen {
  display: flex;
  justify-content: center;
  align-items: center;

  width: 200rpx;
  min-height: 200rpx;
}
.result .option-chosen .text-chosen {
  width: 450rpx;
  min-height: 200rpx;

  border-left: 5rpx solid #000000;

  color: #000000;
  word-break: break-all;
}
.result .result-button {
  position: absolute;
  bottom: 50rpx;
}



.mask {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  z-index: 9999;

  background-color: #69696980;

  font-size: 50rpx
}



.delete-menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  z-index: 998;

  background-color: #69696900;

  font-size: 50rpx
}